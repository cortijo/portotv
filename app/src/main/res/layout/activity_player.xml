<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/preto">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Card de informações do canal: aparece 4s ao trocar de canal e some
         sozinho, igual à sensação de uma TV digital comum. Visual em card
         arredondado com pill de categoria, badge de número e favoritar,
         no estilo de referência pedido pelo usuário. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:background="@drawable/fundo_card_banner"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Linha 1: pill de categoria + botão de favoritar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bannerCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_categoria"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="@color/branco"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="TV Aberta"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/bannerFavorito"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/favoritar_canal"
                android:padding="2dp"
                android:src="@drawable/ic_favorito_off" />
        </LinearLayout>

        <!-- Linha 2: logo + número + nome do canal. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bannerLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/fundo_codigo"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/bannerNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/fundo_badge_numero"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="42" />

            <TextView
                android:id="@+id/bannerNome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="SBT" />
        </LinearLayout>

        <!-- Linha 3: programa atual (título + sinopse). -->
        <TextView
            android:id="@+id/bannerPrograma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Fofocalizando" />

        <TextView
            android:id="@+id/bannerSinopse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/portonet_cinza_claro"
            android:textSize="14sp"
            tools:text="Revista eletrônica com informação, humor e as principais fofocas do mundo dos famosos." />

        <!-- Linha 4: barra de progresso do programa atual. -->
        <ProgressBar
            android:id="@+id/bannerProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progressTint="@color/portonet_azul_vivo" />

        <!-- Linha 5: horário do programa atual + tempo restante. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bannerHorario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/portonet_cinza_claro"
                android:textSize="13sp"
                tools:text="15:20 – 17:00" />

            <TextView
                android:id="@+id/bannerRestante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/portonet_cinza_claro"
                android:textSize="13sp"
                tools:text="1h12min" />
        </LinearLayout>

        <!-- Linha 6: a seguir. -->
        <TextView
            android:id="@+id/bannerProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/portonet_cinza_claro"
            android:textSize="13sp"
            tools:text="A seguir: 17:00 O que a Vida me Roubou" />
    </LinearLayout>

    <!-- Numpad: digitar o número do canal direto, como controle de TV a cabo. -->
    <TextView
        android:id="@+id/numpad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@color/overlay_video"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@color/branco"
        android:textSize="28sp"
        android:visibility="gone"
        tools:text="123" />

    <!-- Overlay de canal indisponível: todas as fontes do canal atual
         falharam depois de esgotar as retentativas. Cobre o player até o
         usuário sintonizar um canal/fonte que funcione. -->
    <LinearLayout
        android:id="@+id/manutencao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/portonet_azul_marinho"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_portonet" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/canal_em_manutencao"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lista lateral de canais — seta esquerda abre, VOLTAR fecha. -->
    <LinearLayout
        android:id="@+id/listaPainel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:background="@color/overlay_video"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Alterna a lista entre "todos os canais" e "só os favoritos". -->
        <LinearLayout
            android:id="@+id/filtroFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_item_canal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:id="@+id/filtroFavoritosIcone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorito_off" />

            <TextView
                android:id="@+id/filtroFavoritosTexto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/mostrar_somente_favoritos"
                android:textColor="@color/branco"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCanais"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="16dp" />
    </LinearLayout>

</FrameLayout>
